{
  "name": "dsh-plugin-vault",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksxh0524/dsh-plugin-vault.git"
  },
  "description": "通用存储层插件（一 ns 一库 + 全局内容寻址字节家）：vault_put_blob/vault_get_blob/vault_db_exec/vault_db_query/vault_ns_info 五工具；包根库面冻结（老调用方迁移波再断），插件壳走 ./cordis 子路径。",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cordis": "./src/cordis.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^24.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "dsh-check": "link:../dsh-check"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,md,yml,yaml,html}": "prettier --write"
  },
  "packageManager": "pnpm@11.5.3"
}
